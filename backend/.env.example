# Server Configuration
PORT=5001
HOST=0.0.0.0
NODE_ENV=development

# Database Connection (MongoDB)
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/digischool?retryWrites=true&w=majority"
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/digischool?retryWrites=true&w=majority"

# Authentication Secrets
JWT_ACCESS_SECRET="your-super-secret-access-key-min-32-chars-long"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Client CORS
CLIENT_ORIGIN="http://localhost:5173"

# Uploads directory
UPLOAD_DIR="./uploads"

# File Storage Provider: "cloudinary" | "imagekit" | "local"
STORAGE_PROVIDER="cloudinary"

# Cloudinary Configuration (Option 1)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Or CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# ImageKit Configuration (Option 2)
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""

# Initial Super Admin Credentials (Configured & Seeded into DB via Argon2id)
ADMIN_EMAIL="admin@digischool.com"
ADMIN_PASSWORD="YourStrongPasswordHere"

